# ==========================================================
# 1. CLASE NODO
# ==========================================================

class Nodo:

    def __init__(self, nombre, tipo, tiempo):

        # Guardamos el nombre del cliente
        self.nombre = nombre

        # Guardamos el tipo:
        # "preferencial" o "normal"
        self.tipo = tipo

        # Guardamos cuánto demora su atención
        self.tiempo = tiempo

        # Aquí vamos a guardar el siguiente cliente
        #
        # Al principio no hay siguiente cliente,
        # por eso empieza en None.
        self.siguiente = None


# ==========================================================
# 2. CLASE COLA
# ==========================================================

class Cola:

    def __init__(self):

        # "inicio" apunta al primer cliente.
        #
        # Al comenzar no tenemos clientes,
        # entonces la cola está vacía.
        self.inicio = None


    # ======================================================
    # 3. AGREGAR CLIENTE
    # ======================================================

    def agregar(self, nombre, tipo, tiempo):

        # Primero creamos un nuevo nodo
        nuevo = Nodo(nombre, tipo, tiempo)


        # --------------------------------------------------
        # SI EL CLIENTE ES PREFERENCIAL
        # --------------------------------------------------

        if tipo == "preferencial":

            # El nuevo cliente apunta al que actualmente
            # estaba primero.
            #
            # Ejemplo:
            #
            # Antes:
            # Juan -> Pedro
            #
            # Entra Maria:
            #
            # Maria -> Juan -> Pedro

            nuevo.siguiente = self.inicio

            # Ahora Maria se convierte en el primer cliente
            self.inicio = nuevo


        # --------------------------------------------------
        # SI EL CLIENTE ES NORMAL
        # --------------------------------------------------

        elif tipo == "normal":

            # Los normales deben ir al FINAL.
            #
            # Para encontrar el final vamos a usar
            # una función RECURSIVA.
            self.inicio = self.insertar_final(
                self.inicio,
                nuevo
            )


    # ======================================================
    # 4. INSERTAR AL FINAL - RECURSIVO
    # ======================================================

    def insertar_final(self, actual, nuevo):

        # -------- CASO BASE --------
        #
        # Si actual es None significa que llegamos
        # al final de la cola.
        #
        # Ejemplo:
        #
        # Juan -> Pedro -> None
        #                 ↑
        #              llegamos aquí
        #
        # Entonces colocamos el nuevo nodo aquí.

        if actual is None:

            return nuevo


        # -------- LLAMADA RECURSIVA --------
        #
        # Si todavía no estamos al final,
        # avanzamos al siguiente nodo.

        actual.siguiente = self.insertar_final(
            actual.siguiente,
            nuevo
        )


        # Devolvemos el nodo actual para no perder
        # la conexión de la cola.

        return actual


    # ======================================================
    # 5. CALCULAR TIEMPO DE ESPERA - RECURSIVO
    # ======================================================

    def tiempo_espera(self, nombre):

        # Empezamos desde el primer cliente.
        #
        # El acumulado comienza en 0 porque todavía
        # no hemos pasado por ningún cliente.

        return self.calcular_espera(
            self.inicio,
            nombre,
            0
        )


    def calcular_espera(self, actual, nombre, acumulado):

        # -------- CASO BASE --------
        #
        # Si llegamos al final y no encontramos
        # al cliente, devolvemos -1.
        #
        # Esto es exactamente lo que pide el examen.

        if actual is None:

            return -1


        # -------- CASO BASE --------
        #
        # Si encontramos al cliente que estamos buscando,
        # devolvemos el tiempo que llevamos acumulado.

        if actual.nombre == nombre:

            return acumulado


        # -------- RECURSIVIDAD --------
        #
        # Todavía no encontramos al cliente.
        #
        # Entonces:
        #
        # 1. Pasamos al siguiente cliente.
        # 2. Sumamos el tiempo del cliente actual.

        return self.calcular_espera(
            actual.siguiente,
            nombre,
            acumulado + actual.tiempo
        )


    # ======================================================
    # 6. ATENDER AL PRIMER CLIENTE
    # ======================================================

    def atender(self):

        # Primero preguntamos:
        #
        # ¿La cola está vacía?
        #
        # Si inicio es None, no hay nadie.

        if self.inicio is None:

            return None


        # Guardamos el primer cliente
        # antes de quitarlo.

        atendido = self.inicio


        # Ahora el segundo cliente pasa a ser
        # el primero.

        self.inicio = self.inicio.siguiente


        # Desconectamos al cliente atendido
        # de la cola.

        atendido.siguiente = None


        # Devolvemos el cliente que atendimos.

        return atendido


    # ======================================================
    # 7. CONTAR PREFERENCIALES Y NORMALES - RECURSIVO
    # ======================================================

    def contar_por_tipo(self):

        # Comenzamos desde el primer nodo.

        return self.contar_recursivo(self.inicio)


    def contar_recursivo(self, actual):

        # -------- CASO BASE --------
        #
        # Si no hay nodo, significa que terminamos.
        #
        # Retornamos:
        #
        # (preferenciales, normales)
        #
        # Al principio hay 0 y 0.

        if actual is None:

            return (0, 0)


        # -------- RECURSIVIDAD --------
        #
        # Primero contamos todos los clientes
        # que vienen después.

        preferenciales, normales = self.contar_recursivo(
            actual.siguiente
        )


        # Cuando la función comienza a regresar,
        # revisamos el cliente actual.

        if actual.tipo == "preferencial":

            preferenciales += 1

        elif actual.tipo == "normal":

            normales += 1


        # Devolvemos los dos contadores.

        return (preferenciales, normales)


    # ======================================================
    # 8. MOSTRAR LA COLA
    # ======================================================

    def mostrar(self):

        # Comenzamos desde el primer cliente.

        actual = self.inicio


        # Mientras exista un cliente,
        # seguimos recorriendo.

        while actual is not None:

            print(
                actual.nombre,
                "-",
                actual.tipo,
                "-",
                actual.tiempo,
                "minutos"
            )


            # Pasamos al siguiente cliente.

            actual = actual.siguiente


# ==========================================================
# 9. PROBAR EL PROGRAMA
# ==========================================================

cola = Cola()


# Agregamos un cliente normal
cola.agregar("Juan", "normal", 10)

# Agregamos un preferencial
cola.agregar("Maria", "preferencial", 5)

# Otro normal
cola.agregar("Pedro", "normal", 15)

# Otro preferencial
cola.agregar("Ana", "preferencial", 8)


# ==========================================================
# 10. MOSTRAR LA COLA
# ==========================================================

print("COLA:")

cola.mostrar()


# ==========================================================
# 11. TIEMPO DE ESPERA
# ==========================================================

print()

print("Tiempo de espera de Pedro:")

print(
    cola.tiempo_espera("Pedro")
)


# ==========================================================
# 12. CONTAR CLIENTES
# ==========================================================

print()

print("Clientes por tipo:")

print(
    cola.contar_por_tipo()
)


# ==========================================================
# 13. ATENDER
# ==========================================================

print()

print("Cliente atendido:")

atendido = cola.atender()


if atendido is not None:

    print(atendido.nombre)
